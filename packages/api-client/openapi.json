        "properties": {
          "episode_id": {
            "type": "string",
            "format": "uuid",
            "title": "Episode Id"
          },
          "show_id": {
            "type": "string",
            "format": "uuid",
            "title": "Show Id"
          },
          "show_title": {
            "type": "string",
            "title": "Show Title"
          },
          "poster_url": {
