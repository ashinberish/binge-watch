{
  "name": "@nightreel/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ./openapi.json -o ./src/schema.d.ts",
    "check:drift": "openapi-typescript ./openapi.json -o ./src/schema.d.ts && git diff --exit-code -- src/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "openapi-fetch": "^0.14.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.9.1",
    "typescript": "^5.9.2",
    "vitest": "^5.0.5"
  }
}
