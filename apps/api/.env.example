# Nightreel API settings. Copy to apps/api/.env for local runs; every variable is APP_-prefixed.
# See src/app/core/config.py for the full list and defaults.

APP_ENVIRONMENT=local
APP_DEBUG=false
APP_LOG_LEVEL=INFO
# true = JSON logs (deployed envs), false = pretty console
APP_LOG_JSON=false

# Database (async SQLAlchemy URL). docker-compose overrides the host to `postgres`.
APP_DATABASE_URL=postgresql+asyncpg://nightreel:nightreel@localhost:5432/nightreel
APP_DATABASE_ECHO=false
APP_DATABASE_POOL_SIZE=5
APP_DATABASE_MAX_OVERFLOW=10

# Redis / Celery (broker and result backend default to APP_REDIS_URL)
APP_REDIS_URL=redis://localhost:6379/0
# APP_CELERY_BROKER_URL=
# APP_CELERY_RESULT_BACKEND=

# Auth. MUST be overridden outside local dev (>= 32 random bytes): openssl rand -hex 32
APP_JWT_SECRET=dev-insecure-change-me-0123456789abcdef
APP_JWT_ALGORITHM=HS256
APP_ACCESS_TOKEN_TTL_SECONDS=900
APP_REFRESH_TOKEN_TTL_SECONDS=2592000

# CORS: comma-separated origins (web app). The regex is full-matched (no anchors needed)
# and admits the Chrome extension.
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
APP_CORS_ORIGIN_REGEX=chrome-extension://[a-p]{32}

# Observability (no-op unless set and the SDK is installed)
# APP_SENTRY_DSN=
# APP_OTEL_EXPORTER_OTLP_ENDPOINT=

# Integrations (not used yet)
# APP_TMDB_API_KEY=
APP_TMDB_BASE_URL=https://api.themoviedb.org/3
